rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ CAMBIA este correo por el del usuario administrador que creaste en Authentication.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "alfredito1592@gmail.com";
    }

    // Configuración de la tarjeta, productos y servicios: todos leen, solo el admin escribe.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Galería de trabajos (fotos y videos): todos ven, solo el admin sube y cambia.
    match /galeria/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Datos públicos del cliente (nombre, sellos...). Se consulta por número de WhatsApp.
    match /clientes/{tel} {
      allow get: if true;
      allow list: if isAdmin();

      // El cliente se registra con la tarjeta en cero.
      allow create: if tel.matches('^[0-9]{9,15}$')
        && request.resource.data.keys().hasOnly(['nombre', 'apellido', 'sellos', 'total', 'canjes', 'ultima'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60
        && request.resource.data.apellido is string && request.resource.data.apellido.size() <= 60
        && request.resource.data.sellos == 0
        && request.resource.data.total == 0
        && request.resource.data.canjes == 0
        && request.resource.data.ultima.toMillis() == 0;   // 'ultima' se guarda como fecha (timestamp)

      // El cliente solo puede sumar UNA visita (escaneo del QR). Canjes, borrar, etc.: solo admin.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellos', 'total', 'ultima', 'hist', 'gan'])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.sellos >= 1
        && request.resource.data.sellos <= resource.data.sellos + 1
        && request.resource.data.ultima > resource.data.ultima
      );

      allow delete: if isAdmin();
    }

    // Datos privados (correo y nacimiento): el cliente solo puede crearlos al registrarse.
    match /privados/{tel} {
      allow create: if tel.matches('^[0-9]{9,15}$')
        && request.resource.data.keys().hasOnly(['tel', 'email', 'nac', 'creado'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 80
        && request.resource.data.nac is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
